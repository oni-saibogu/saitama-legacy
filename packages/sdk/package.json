{
  "name": "@saitamafun/sdk",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "main": "./dist/index.cjs",
  "types": "./src/index.ts",
  "publishConfig": {
    "@saitamafun:registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup src/index.ts src/api/index.ts src/networks/index.ts src/dexscreener/index.ts --format cjs --minify --treeshake"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.cjs",
      "default": "./src/index.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "require": "./dist/api/index.cjs",
      "default": "./src/api/index.ts"
    },
    "./networks": {
      "types": "./src/networks/index.ts",
      "require": "./dist/networks/index.cjs",
      "default": "./src/networks/index.ts"
    },
    "./dexscreener": {
      "types": "./src/dexscreener/index.ts",
      "require": "./dist/dexscreener/index.cjs",
      "default": "./src/dexscreener/index.ts"
    }
  },
  "type": "module",
  "devDependencies": {
    "typescript": "latest"
  },
  "dependencies": {
    "@saitamafun/shared": "*",
    "@coral-xyz/anchor": "^0.31.0",
    "@saitamafun/tsconfig": "*",
    "@solana/spl-memo": "^0.2.5",
    "@solana/spl-token": "^0.4.13",
    "@solana/wallet-adapter-base": "^0.9.23",
    "assert": "^2.1.0",
    "tronweb": "^6.0.2",
    "viem": "^2.26.3",
    "xior": "^0.5.3"
  }
}
