{
  "name": "@saitamafun/api",
  "type": "module",
  "version": "0.0.0",
  "module": "src/index.ts",
  "license": "AGPL-3.0-only",
  "scripts": {
    "codegen": "bun scripts/codegen.ts",
    "start": "node dist/index.cjs",
    "anvil:start": "anvil",
    "amman:start": "bun x amman start",
    "gen:id-token": "firebase-generate-id-token",
    "dev": "bun run codegen && nodemon --exec bun run src/index.ts",
    "migrate": "npx drizzle-kit generate && npx drizzle-kit migrate",
    "create-key": "npx --yes @fastify/secure-session > secret-key",
    "build": "tsup src/index.ts src/watch/index.ts --format cjs --minify --treeshake",
    "dev:watch": "bun run codegen && nodemon --exec bun run src/watch/index.ts",
    "devnet:start": "concurrently \"npm run anvil:start\" \"npm run amman:start\""
  },
  "devDependencies": {
    "@metaplex-foundation/amman": "^0.12.1",
    "@saitamafun/tsconfig": "*",
    "@types/bcrypt": "^5.0.2",
    "@types/bun": "^1.2.15",
    "@types/passport-jwt": "^4.0.1",
    "bun": "^1.2.15",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.1",
    "firebase-id-token-generator": "^1.0.1",
    "hardhat": "^2.24.1",
    "nodemon": "^3.1.10"
  },
  "peerDependencies": {
    "typescript": "latest"
  },
  "dependencies": {
    "@saitamafun/sdk": "*",
    "@saitamafun/shared": "*",
    "@coral-xyz/anchor": "^0.31.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/passport": "^3.0.2",
    "@fastify/secure-session": "^8.2.0",
    "@fastify/swagger": "^9.5.1",
    "@scalar/fastify-api-reference": "^1.31.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.2",
    "@telegram-apps/init-data-node": "^1.2.2",
    "@web3icons/core": "^4.0.13",
    "assert": "^2.1.0",
    "bcrypt": "^5.1.1",
    "bip32": "^5.0.0-rc.0",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "crypto": "^1.0.1",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.43.1",
    "drizzle-zod": "^0.7.1",
    "ed25519-hd-key": "^1.3.0",
    "ethers": "^6.14.3",
    "fast-json-stringify": "^6.0.1",
    "fastify": "^5.3.3",
    "fastify-socket.io": "^5.1.0",
    "firebase-admin": "^12.7.0",
    "fs": "^0.0.1-security",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.10.1",
    "passport-custom": "^1.1.1",
    "passport-jwt": "^4.0.1",
    "passport-jwt-cookiecombo": "^1.0.5",
    "postgres": "^3.4.7",
    "redis": "^5.1.1",
    "socket.io": "^4.8.1",
    "tiny-secp256k1": "^2.2.3",
    "tronweb": "^6.0.3",
    "viem": "^2.30.5",
    "xior": "^0.7.8",
    "zod": "^3.25.46",
    "zod-to-json-schema": "^3.24.5"
  }
}
